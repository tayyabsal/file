            preds = model(src, trg_input, src_mask, trg_mask)

            optim.zero_grad()

            loss = F.cross_entropy(
                preds.view(-1, preds.size(-1)),
                targets,
                ignore_index=target_pad
            )
            loss.backward()
            optim.step()

            total_loss += loss.item()

            # Calculate accuracy
            predictions = preds.argmax(dim=-1)
            predictions = predictions.view(-1)
            targets = targets.view(-1)

            correct_predictions += (predictions == targets).sum().item()
            total_predictions += targets.numel()

            if (i + 1) % print_every == 0:
                loss_avg = total_loss / print_every
                perplexity = math.exp(loss_avg)
                accuracy = correct_predictions / total_predictions

                # Update maximum accuracy if the current accuracy is higher
                max_accuracy = max(max_accuracy, accuracy)

                print("time = {}, epoch {}, iter = {}, loss = {}, perplexity = {}, accuracy = {}, {} per {} iters".format(
                    (datetime.now() - start) // 60,
                    epoch + 1,
                    i + 1,
                    loss_avg,
                    perplexity,
                    accuracy,
                    datetime.now() - temp,
                    print_every
                ))

                Loss_hist.append(loss_avg)
                Perplexity_hist.append(perplexity)
                Accuracy_hist.append(accuracy)
                total_loss = 0
                temp = datetime.now()
                correct_predictions = 0
                total_predictions = 0

    # Print the maximum accuracy achieved
    print(f"Maximum accuracy achieved: {max_accuracy}")

